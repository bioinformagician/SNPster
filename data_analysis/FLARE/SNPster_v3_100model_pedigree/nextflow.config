/*
 * SNPster ancestry strategy benchmark v3
 *
 * Optimized for:
 *   20 CPU cores
 *   180 GB Docker memory limit
 *
 * Design:
 *   - Leave a few GB outside Nextflow's scheduling pool for the
 *     Nextflow JVM, filesystem cache and native allocations.
 *   - Pipeline expensive FLARE/model-building stages together.
 *   - Run up to 3 FLARE inference jobs concurrently.
 *   - Saturate all 20 cores during decoder sweeps.
 */

executor {
    name   = 'local'
    cpus   = 20
    memory = '176 GB'
}


/*
 * Default. Every important process is overridden below.
 */
process {
    executor = 'local'

    cpus   = 1
    memory = '2 GB'

    /*
     * ------------------------------------------------------------------
     * PANEL_PROBS
     *
     * Only one job in the normal search.
     * It gates essentially the entire workflow, so give it most CPUs.
     *
     * main.nf uses Java -Xmx48g.
     * ------------------------------------------------------------------
     */
    withName: 'PANEL_PROBS' {
        cpus      = 18
        memory    = '56 GB'
        maxForks  = 1
        errorStrategy = 'retry'
        maxRetries = 1
    }


    /*
     * ------------------------------------------------------------------
     * BUILD_INITIAL_MODEL
     *
     * GMM / Bayesian GMM / KMeans / PCA.
     *
     * Two may run at once:
     *
     *   2 × 6 CPU = 12 CPU
     *   2 × 60 GB = 120 GB
     *
     * This also permits useful pipelining with REFINE_MODEL as individual
     * initial models become available.
     * ------------------------------------------------------------------
     */
    withName: 'BUILD_INITIAL_MODEL' {
        cpus      = 2
        memory    = '20 GB'
        maxForks  = 8
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * REFINE_MODEL
     *
     * FLARE update-p / EM refinement.
     *
     * main.nf uses Java -Xmx64g.
     *
     * Two concurrent jobs:
     *
     *   2 × 8 CPU  = 16 CPU
     *   2 × 72 GB  = 144 GB
     *
     * Much better than serial 11-CPU jobs.
     * ------------------------------------------------------------------
     */
    withName: 'REFINE_MODEL' {
        cpus      = 8
        memory    = '72 GB'
        maxForks  = 2
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * FIXED BASELINE IMPORT
     * ------------------------------------------------------------------
     */
    withName: 'IMPORT_FIXED_MODEL' {
        cpus      = 1
        memory    = '2 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }


    /*
     * ------------------------------------------------------------------
     * FLARE inference
     *
     * main.nf uses Java -Xmx32g.
     *
     * Three jobs:
     *
     *   3 × 6 CPU = 18 CPU
     *   3 × 44 GB = 132 GB
     *
     * Leaves enough space for a small decoder/light task alongside them.
     * ------------------------------------------------------------------
     */
    withName: 'RUN_REPRESENTATION_DEV' {
        cpus      = 6
        memory    = '44 GB'
        maxForks  = 3
        errorStrategy = 'ignore'
    }

    withName: 'RUN_REPRESENTATION_DIAGNOSTIC' {
        cpus      = 6
        memory    = '44 GB'
        maxForks  = 3
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * Stage-1 representation screen
     *
     * sklearn receives SKLEARN_N_JOBS=${task.cpus}.
     * ------------------------------------------------------------------
     */
    withName: 'SCREEN_REPRESENTATION' {
        cpus      = 2
        memory    = '8 GB'
        maxForks  = 10
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * Main decoder hyperparameter sweep
     *
     * This is where we want maximum throughput:
     *
     *   10 × 2 CPU = all 20 cores
     *
     * The datasets here are comparatively small, so 8 GB/task is ample.
     * ------------------------------------------------------------------
     */
    withName: 'FIT_STAGE2_CANDIDATE' {
        cpus      = 2
        memory    = '8 GB'
        maxForks  = 10
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * Full evaluation of selected candidates
     * ------------------------------------------------------------------
     */
    withName: 'FULL_EVALUATE_CANDIDATE' {
        cpus      = 2
        memory    = '10 GB'
        maxForks  = 10
        errorStrategy = 'ignore'
    }


    /*
     * ------------------------------------------------------------------
     * Lightweight orchestration / selection jobs
     * ------------------------------------------------------------------
     */
    withName: 'SELECT_REPRESENTATIONS' {
        cpus      = 1
        memory    = '3 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }

    withName: 'GENERATE_STAGE2_CANDIDATES' {
        cpus      = 1
        memory    = '3 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }

    withName: 'SELECT_STAGE2_CANDIDATES' {
        cpus      = 1
        memory    = '4 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }

    withName: 'AGGREGATE_FINAL' {
        cpus      = 1
        memory    = '4 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }

    withName: 'PDB_SELECT_UNIFIED_FINALISTS' {
        cpus      = 2
        memory    = '8 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }
    withName: 'SELECT_FINALISTS' {
        cpus      = 1
        memory    = '4 GB'
        maxForks  = 1
        errorStrategy = 'terminate'
    }
    // Ped-sim extension (only called when --pedigree_enabled true).
    withLabel: 'pdb_light' {
        cpus = 1
        memory = '4 GB'
        maxForks = 1
        errorStrategy = 'terminate'
    }
    withLabel: 'pdb_sim' {
        cpus = 2
        memory = '36 GB'
        maxForks = 2
        errorStrategy = 'terminate'
    }
    withLabel: 'pdb_flare' {
        cpus = 6
        memory = '44 GB'
        maxForks = 2
        errorStrategy = 'terminate'
    }
    withLabel: 'pdb_decoder' {
        cpus = 2
        memory = '10 GB'
        maxForks = 2
        errorStrategy = 'terminate'
    }
}


/*
 * Keep profiling enabled. For this benchmark it is actually useful,
 * because we can inspect real peak RAM / CPU afterwards and tighten
 * these allocations for the 522-model experiment.
 */
trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true

    fields = 'task_id,hash,native_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}

report {
    enabled   = true
    file      = 'report.html'
    overwrite = true
}

timeline {
    enabled   = true
    file      = 'timeline.html'
    overwrite = true
}

/*
 * DAG isn't particularly useful for repeated runs and adds another
 * report-generation step.
 */
dag.enabled = false
