params.project = '/home/frederik/github_projects/SNPster/data_analysis/FLARE/SNPster_v3_100model_pedigree'
params.run_dir = null
params.smoke = true
params.container_options = ''
process {
    executor = 'local'
    cpus = 1
    memory = '4 GB'
    errorStrategy = 'terminate'
    containerOptions = params.container_options
}
executor {
    cpus = 4
    memory = '20 GB'
    queueSize = 2
}
docker.enabled = true
docker.runOptions = '--network none'
env {
    PYTHONDONTWRITEBYTECODE = '1'
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    POLARS_MAX_THREADS = '1'
}
