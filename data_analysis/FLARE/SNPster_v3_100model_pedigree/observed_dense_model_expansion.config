params.project = '/home/frederik/github_projects/SNPster/data_analysis/FLARE/SNPster_v3_100model_pedigree'
params.run_dir = null
params.source = null
params.plan = null
params.smoke = true
params.recovery = ''
params.container_options = ''
process {
    executor = 'local'
    errorStrategy = 'terminate'
    containerOptions = params.container_options
}
executor {
    cpus = 22
    memory = '180 GB'
    queueSize = 22
}
docker.enabled = true
docker.runOptions = '--network none'
env {
    PYTHONDONTWRITEBYTECODE = '1'
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    POLARS_MAX_THREADS = '1'
    MPLCONFIGDIR = '/tmp/matplotlib'
    NUMBA_CACHE_DIR = '/tmp/numba-cache'
}
