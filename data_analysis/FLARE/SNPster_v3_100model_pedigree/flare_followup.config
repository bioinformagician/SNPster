params {
    mode = 'smoke'
    outdir = null
    source_manifest = null
    container_options = ''
}
executor {
    name = 'local'
    cpus = 12
    memory = '30 GB'
    queueSize = 4
}
process {
    executor = 'local'
    container = 'sha256:08a7c550ecd61aa3709379b3cf610b4d650cb655b59550c435d36e774c83868d'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
}
docker {
    enabled = true
    runOptions = params.container_options
}
env {
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONUNBUFFERED = '1'
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
}
trace {
    enabled = true
    file = "${params.outdir}/${params.mode}/trace.tsv"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/${params.mode}/execution_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/${params.mode}/timeline.html"
    overwrite = true
}
