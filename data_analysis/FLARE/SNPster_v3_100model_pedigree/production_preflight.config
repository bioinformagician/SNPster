params {
    project = null
    run_dir = null
    production_root = '/srv/dependencies/imputation_runner/imputer'
    authority = '/srv/dependencies/ancestry/flare2_test/source_model/ancestry_role_audit.tsv'
    container_options = ''
}
executor {
    name = 'local'
    cpus = 4
    memory = '8 GB'
    queueSize = 2
}
process {
    container = 'sha256:08a7c550ecd61aa3709379b3cf610b4d650cb655b59550c435d36e774c83868d'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
}
docker {
    enabled = true
    runOptions = params.container_options
}
env {
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONUNBUFFERED = '1'
}
trace {
    enabled = true
    file = "${params.run_dir}/trace.tsv"
}
report {
    enabled = true
    file = "${params.run_dir}/execution_report.html"
}
timeline {
    enabled = true
    file = "${params.run_dir}/timeline.html"
}
