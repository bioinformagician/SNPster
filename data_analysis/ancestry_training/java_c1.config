// The environment-only image gives Java tasks an explicit, distinct cache identity.
params.java_c1_image = 'sha256:bc523b63202a52dd2aad32ccadb7813c179c37c93fe89168bc3ae2c1c0172547'

process {
    withName: PHASE {
        container = params.java_c1_image
    }
    withName: INFER {
        container = { family == 'gnomix' ? params.gnomix_image : params.java_c1_image }
    }
}
