params {
    experiment = null
    output = null
    image = 'sha256:08a7c550ecd61aa3709379b3cf610b4d650cb655b59550c435d36e774c83868d'
    gnomix_image = 'sha256:c4fd14a99e9d84839245b9242f36cf84306c32e67fa93b65fa5dbe5408d30e21'
    budget_cpus = 1
    budget_memory = '8 GB'
    task_memory = '8 GB'
    pca_memory = null
    inference_chunk_size = 1
    reuse_manifest = null
    container_options = ''
    recover_release = false
    smoke_only = false
}
process {
    executor = 'local'
    container = params.image
    cpus = 1
    memory = params.task_memory
    maxForks = params.budget_cpus
    errorStrategy = 'terminate'
    containerOptions = {
        "--cpus=${task.cpus} --memory=${task.memory.toMega()}m -e SNPSTER_JAVA_HEAP_MB=${(task.memory.toMega() * 0.70) as int}"
    }
    withName: BASE {
        memory = { family.startsWith('pca_') && params.pca_memory ? params.pca_memory : params.task_memory }
    }
}
executor {
    cpus = params.budget_cpus
    memory = params.budget_memory
    queueSize = params.budget_cpus
}
docker {
    enabled = true
    runOptions = params.container_options
}
report.overwrite = true
timeline.overwrite = true
env {
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMBA_NUM_THREADS = '1'
    MPLCONFIGDIR = '/tmp/snpster-matplotlib'
    NUMBA_CACHE_DIR = '/tmp/snpster-numba'
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONFAULTHANDLER = '1'
}
