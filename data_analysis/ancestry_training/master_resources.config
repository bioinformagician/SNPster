params {
    specification = null
    output = null
    image = 'sha256:08a7c550ecd61aa3709379b3cf610b4d650cb655b59550c435d36e774c83868d'
    budget_cpus = 12
    budget_memory = '96 GB'
    container_options = ''
    smoke_only = false
    prepared_resources = null
}
process {
    executor = 'local'
    container = params.image
    cpus = 1
    memory = '8 GB'
    maxForks = params.budget_cpus
    errorStrategy = 'terminate'
    containerOptions = {
        "--cpus=${task.cpus} --memory=${task.memory.toMega()}m -e SNPSTER_JAVA_HEAP_MB=${(task.memory.toMega() * 0.70) as int}"
    }
    withName: SCREEN_ALL_RESOURCE_RELATIONSHIPS {
        cpus = 4
        memory = '32 GB'
        maxForks = 1
    }
}
executor {
    cpus = params.budget_cpus
    memory = params.budget_memory
    queueSize = params.budget_cpus
}
docker {
    enabled = true
    runOptions = params.container_options
}
report.overwrite = true
timeline.overwrite = true
env {
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    MPLCONFIGDIR = '/tmp/snpster-matplotlib'
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONFAULTHANDLER = '1'
}
