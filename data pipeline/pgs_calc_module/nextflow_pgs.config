trace {
  enabled = true
  file = "${System.getenv('NF_REPORT_DIR') ?: '/app/nf_reports'}/pgs_trace_${new Date().format('yyyyMMdd-HHmmss')}.txt"
  overwrite = true
  fields = 'task_id,process,tag,status,exit,attempt,realtime,duration,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

timeline {
  enabled = true
  file = "${System.getenv('NF_REPORT_DIR') ?: '/app/nf_reports'}/pgs_timeline_${new Date().format('yyyyMMdd-HHmmss')}.html"
  overwrite = true
}

report {
  enabled = true
  file = "${System.getenv('NF_REPORT_DIR') ?: '/app/nf_reports'}/pgs_report_${new Date().format('yyyyMMdd-HHmmss')}.html"
  overwrite = true
}

// Executor limits and per-process resources are generated per run into nextflow_pgs_resources.config.
