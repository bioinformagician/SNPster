executor {
  name = 'local'
  cpus = 11
  memory = '90 GB'
}


process { 
  // Reduce contention inside the container while ancestry steps run.
  maxForks = 4

  withName: 'PGSCATALOG_PGSCCALC:PGSCCALC:ANCESTRY_PROJECT:INTERSECT_VARIANTS' {
    memory = 70.GB
    cpus = 6
    maxForks = 1
  }

  // Fallback selector in case module naming differs across pgsc_calc versions.
  withName: 'INTERSECT_VARIANTS' {
    memory = 70.GB
    cpus = 6
    maxForks = 1
  }

}
