    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from IPython.display import display\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "import plotly.express as px\n",
        "import sys\n",
        "from pathlib import Path\n",
        "\n",
        "sys.path.insert(0, str(Path.cwd().parent / \"database_module\"))\n",
        "\n",
        "from db_handler import DbHandler, DbUtils\n",
        "from db_config import USERNAME, PASSWORD, DATABASE_NAME, HOST, PORT, PGS_EXCEL_FILEPATH\n",
        "\n",
        "\n",
        "db_handler = DbHandler(port=PORT, db_url=None, user=USERNAME, password=PASSWORD, host=HOST)\n",
        "\n",
        "db_handler.connect()\n",
        "\n",
        "db_utils = DbUtils(db_handler)\n",
        "\n",
        "\n",
        "\n",
        "user_pgs_scores = pd.read_csv(\n",
        "    r\"C:\\Users\\frezz\\Downloads\\snpster\\data pipeline\\reporting_module\\data\\multiple_pgs_scores_example.zip\", sep=\"\\t\"\n",
        ")\n",
        "\n",
        "\"\"\"\n",
        "Index(['sampleset', 'FID', 'IID', 'PGS', 'SUM', 'Z_MostSimilarPop', 'Z_norm1',   \n",
        "       'Z_norm2', 'percentile_MostSimilarPop'],\n",
        "      dtype='str')\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "#get metadata\n",
        "\n",
        "user_pgs_scores[\"PGS\"] = user_pgs_scores[\"PGS\"].str.replace(\"_hmPOS_GRCh38\", \"\", regex=False)\n",
        "\n",
        "#only keep sampleset column != reference\n",
        "\n",
        "user_pgs_scores = user_pgs_scores[user_pgs_scores[\"sampleset\"] != \"reference\"]\n",
        "\n",
        "\n",
        "meta_data_query = f\"\"\"\n",
        "SELECT pgs_id, reported_trait, efo_id, number_of_variants,pgp_id, publication_pmid,publication_doi,ftp_link,release_date,ancestry_distribution_source_of_variant_associations_gwas,ancestry_distribution_pgs_evaluation \n",
        "FROM data_libraries.pgscatalog_data\n",
        "WHERE pgs_id IN ({', '.join([f\"'{pgs}'\" for pgs in user_pgs_scores['PGS'].unique()])})\n",
        "\"\"\"\n",
        "\n",
        "meta_data = db_utils.get_pd_dataframe_from_query(meta_data_query)\n",
        "\n",
        "\n",
        "publications_meta_data_query = f\"\"\"SELECT first_author, title, journal_name, publication_date, pgp_id FROM data_libraries.pgs_publications\n",
        "WHERE pgp_id IN ({', '.join([f\"'{pgp}'\" for pgp in meta_data['pgp_id'].unique()])})\n",
        "\"\"\"\n",
        "\n",
        "publications_meta_data = db_utils.get_pd_dataframe_from_query(publications_meta_data_query)\n",
        "\n",
        "pgs_performance_data_query = f\"\"\"SELECT pgp_id, hazard_ratio, odds_ratio, auroc, performance_id, pgs_id, pss_id FROM data_libraries.pgs_performance\n",
        "WHERE pgs_id IN ({', '.join([f\"'{pgs}'\" for pgs in user_pgs_scores['PGS'].unique()])})\n",
        "\"\"\"\n",
        "\n",
        "pgs_performance_data = db_utils.get_pd_dataframe_from_query(pgs_performance_data_query)\n",
        "\n",
        "display(user_pgs_scores.head())\n",
        "display(meta_data.head())\n",
        "display(publications_meta_data.head())\n",
        "display(pgs_performance_data.head())\n",
        "\n",
        "\n",
        "overview_query = f\"\"\"\n",
        "SELECT  pp.auroc, pp.odds_ratio, pp.hazard_ratio, pp.performance_id, pp.pgs_id, pp.pss_id, pp.pgp_id, cd.reported_trait, cd.reported_trait, cd.efo_id, cd.number_of_variants, cd.pgp_id, cd.publication_pmid, cd.publication_doi, cd.ftp_link, cd.release_date, cd.ancestry_distribution_source_of_variant_associations_gwas, cd.ancestry_distribution_pgs_evaluation \n",
        "FROM data_libraries.pgs_performance pp\n",
        "LEFT JOIN data_libraries.pgscatalog_data cd\n",
        "ON pp.pgs_id = cd.pgs_id\n",
        "WHERE pp.auroc IS NOT NULL\n",
        "  AND (\n",
        "        pp.hazard_ratio IS NOT NULL\n",
        "        OR pp.odds_ratio IS NOT NULL\n",
        "      )\n",
        "ORDER BY cd.reported_trait;\n",
        "\"\"\"\n"
      ],
      "id": "3a77dac2",
      "execution_count": null,
      "outputs": []
    },
