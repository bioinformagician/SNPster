      "source": [
        "df = publications_meta_data.copy()\n",
        "\n",
        "\n",
        "\n",
        "# Convert everything to display-friendly strings (avoids weird formatting / NaNs)\n",
        "df_display = df.fillna(\"\").astype(str)\n",
        "\n",
        "# Align numeric-looking columns to the right, others left\n",
        "def is_numeric_col(series: pd.Series) -> bool:\n",
        "    s = pd.to_numeric(series.replace(\"\", pd.NA), errors=\"coerce\")\n",
        "    return s.notna().mean() > 0.85  # mostly numeric\n",
        "\n",
        "col_align = [\"right\" if is_numeric_col(df[c]) else \"left\" for c in df.columns]\n",
        "\n",
        "# Zebra striping\n",
        "row_colors = [\"white\" if i % 2 == 0 else \"#F7F8FA\" for i in range(len(df_display))]\n",
        "\n",
        "fig = go.Figure(\n",
        "    data=[\n",
        "        go.Table(\n",
        "            columnwidth=[1] * len(df_display.columns),\n",
        "            header=dict(\n",
        "                values=[f\"<b>{c}</b>\" for c in df_display.columns],\n",
        "                fill_color=\"#F1F3F5\",\n",
        "                font=dict(color=\"#111827\", size=13, family=\"Inter, Arial\"),\n",
        "                align=\"left\",\n",
        "                height=36,\n",
        "                line_color=\"#E5E7EB\",\n",
        "            ),\n",
        "            cells=dict(\n",
        "                values=[df_display[c].tolist() for c in df_display.columns],\n",
        "                fill_color=[row_colors],  # zebra stripes across rows\n",
        "                font=dict(color=\"#111827\", size=12, family=\"Inter, Arial\"),\n",
        "                align=col_align,\n",
        "                height=30,\n",
        "                line_color=\"#E5E7EB\",\n",
        "            ),\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "fig.update_layout(\n",
        "    title=dict(\n",
        "        text=\"Publications Metadata\",\n",
        "        x=0,\n",
        "        xanchor=\"left\",\n",
        "        font=dict(size=18, family=\"Inter, Arial\", color=\"#111827\"),\n",
        "    ),\n",
        "    paper_bgcolor=\"white\",\n",
        "    plot_bgcolor=\"white\",\n",
        "    margin=dict(l=0, r=0, t=55, b=0),\n",
        "    height=min(850, 140 + 28 * (len(df_display) + 1)),  # auto-ish height\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
