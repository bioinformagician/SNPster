        "## Prepare data\n"
      ],
      "id": "daf565ca"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#print all columns of user_pgs_scores, meta_data, publications_meta_data, pgs_performance_data\n",
        "#print(\"user_pgs_scores columns:\", user_pgs_scores.columns.tolist())\n",
        "#print(\"meta_data columns:\", meta_data.columns.tolist())\n",
        "#print(\"publications_meta_data columns:\", publications_meta_data.columns.tolist())\n",
        "#print(\"pgs_performance_data columns:\", pgs_performance_data.columns.tolist())\n",
        "\n",
        "\n",
        "\n",
        "user_pgs_scores = user_pgs_scores.merge(\n",
        "    meta_data,\n",
        "    left_on=\"PGS\", #default column name from the prs_catalog nextlfow output\n",
        "    right_on=\"pgs_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "print(user_pgs_scores.columns.tolist())\n",
        "\n",
        "user_pgs_scores = user_pgs_scores.merge(\n",
        "    pgs_performance_data,\n",
        "    left_on=[\"pgs_id\", \"pgp_id\"],\n",
        "    right_on=[\"pgs_id\", \"pgp_id\"],\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "print(user_pgs_scores.columns.tolist())\n",
        "\n",
        "user_pgs_scores = user_pgs_scores.merge(\n",
        "    publications_meta_data,\n",
        "    left_on=\"pgp_id\",\n",
        "    right_on=\"pgp_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "\n",
        "print(user_pgs_scores.columns.tolist())"
      ],
      "id": "d9ed31d4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "\n",
        "\n",
        "\n",
        "user_pgs_scores[\"individual_hazard_ratio\"] = (\n",
        "    user_pgs_scores[\"hazard_ratio\"].astype(float) ** user_pgs_scores[\"Z_MostSimilarPop\"].astype(float)\n",
        ")\n",
        "\n",
        "user_pgs_scores[\"individual_odds_ratio\"] = (\n",
        "    user_pgs_scores[\"odds_ratio\"].astype(float) ** user_pgs_scores[\"Z_MostSimilarPop\"].astype(float)\n",
        ")\n",
        "\n",
        "user_pgs_scores[\"individual_risk_ratio\"] = (\n",
        "    user_pgs_scores[\"individual_hazard_ratio\"].combine_first(\n",
        "        user_pgs_scores[\"individual_odds_ratio\"]\n",
        "    )\n",
        ")\n",
        "\n",
        "user_pgs_scores[\"risk\"] = (\n",
        "    (user_pgs_scores[\"individual_risk_ratio\"] - 1) * 100\n",
        ")\n",
        "#add column showing if score is hazard ratio or odds ratio\n",
        "\n",
        "conditions = [\n",
        "    user_pgs_scores[\"risk\"].isna(),\n",
        "    user_pgs_scores[\"individual_hazard_ratio\"].notna(),\n",
        "    user_pgs_scores[\"individual_odds_ratio\"].notna(),\n",
        "]\n",
        "\n",
        "choices = [\n",
        "    \"percentile\",\n",
        "    \"hazard_ratio\",\n",
        "    \"odds_ratio\",\n",
        "]\n",
        "\n",
        "user_pgs_scores[\"risk_type\"] = np.select(conditions, choices, default=None)\n",
        "\n",
        "user_pgs_scores[\"risk\"] = user_pgs_scores[\"risk\"].fillna(user_pgs_scores[\"percentile_MostSimilarPop\"])\n",
        "\n",
        "user_pgs_scores[\"performance_score_id\"] = user_pgs_scores[\"pgs_id\"] + \"_\" + user_pgs_scores[\"pss_id\"].astype(str)\n",
        "\n",
        "print(user_pgs_scores.columns.tolist())"
      ],
      "id": "12669dfd",
      "execution_count": null,
      "outputs": []
