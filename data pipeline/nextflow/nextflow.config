docker.enabled = true
workDir = "$HOME/nf_work"





process {
  withName: STANDARDIZE {
    cpus = 5
    //memory = '10 GB'
    maxForks = 1      
    queueSize = 1
  }

  withName: HARMONIZE {
    cpus = 10
    //memory = '20 GB'
    //maxForks = 2
  }

  withName: IMPUTE {
    cpus = 5
    //memory = '20 GB'
    //maxForks = 1
  }
}