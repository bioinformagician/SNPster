docker.enabled = true
workDir = System.getenv('NXF_WORK') ?: '/srv/imputed/nf_runtime/nf_work'

process {
  withName: STANDARDIZE {
    cpus = 1
    memory = '20 GB'
  }

  withName: HARMONIZE {
    cpus = 1
    memory = '8 GB'
    maxForks = 7
  }

  withName: IMPUTE {
    cpus = 2
    memory = '20 GB'
    maxForks = 7
  }
}